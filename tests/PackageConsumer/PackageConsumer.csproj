<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and !$([System.String]::Copy('$(TargetFramework)').StartsWith('net4'))">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supprocom.FFmpeg.Binaries.linux-x64" Version="9.0.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3"
                      PrivateAssets="all"
                      Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
  </ItemGroup>
</Project>
