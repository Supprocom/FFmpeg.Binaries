<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestRid Condition="'$(TestRid)' == ''">linux-x64</TestRid>
    <SupprocomPackageVersion Condition="'$(SupprocomPackageVersion)' == ''">9.0.2</SupprocomPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supprocom.FFmpeg.Binaries.$(TestRid)" Version="$(SupprocomPackageVersion)" />
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
  </ItemGroup>
</Project>
