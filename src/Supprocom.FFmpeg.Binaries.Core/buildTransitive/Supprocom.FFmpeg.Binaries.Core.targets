<Project>
  <Target Name="SupprocomFFmpegSuppressDefaultNativeCopy"
          BeforeTargets="ResolveLockFileCopyLocalFiles;GenerateBuildDependencyFile;GeneratePublishDependencyFile"
          DependsOnTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('Supprocom.FFmpeg.Binaries.'))" />
    </ItemGroup>
  </Target>

  <Target Name="SupprocomFFmpegSelectPayload"
          BeforeTargets="SupprocomFFmpegValidateSelection"
          Condition="'$(SupprocomFFmpegCopyToOutput)' == 'true'">
    <PropertyGroup>
      <SupprocomFFmpegRuntimeIdentifier Condition="'$(SupprocomFFmpegRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SupprocomFFmpegRuntimeIdentifier>
      <SupprocomFFmpegRuntimeIdentifier Condition="'$(SupprocomFFmpegRuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' != ''">$(NETCoreSdkRuntimeIdentifier)</SupprocomFFmpegRuntimeIdentifier>
      <SupprocomFFmpegDirectory>$(TargetDir)$(SupprocomFFmpegOutputDirectory)</SupprocomFFmpegDirectory>
      <SupprocomFFmpegExecutableSuffix Condition="'$(SupprocomFFmpegRuntimeIdentifier)' == 'win-x86' or '$(SupprocomFFmpegRuntimeIdentifier)' == 'win-x64' or '$(SupprocomFFmpegRuntimeIdentifier)' == 'win-arm64'">.exe</SupprocomFFmpegExecutableSuffix>
      <SupprocomFFmpegPath>$(SupprocomFFmpegDirectory)/ffmpeg$(SupprocomFFmpegExecutableSuffix)</SupprocomFFmpegPath>
      <SupprocomFFprobePath>$(SupprocomFFmpegDirectory)/ffprobe$(SupprocomFFmpegExecutableSuffix)</SupprocomFFprobePath>
    </PropertyGroup>
    <ItemGroup>
      <SupprocomFFmpegPayload Include="@(SupprocomFFmpegAvailablePayload)"
                              Condition="'%(SupprocomFFmpegAvailablePayload.RuntimeIdentifier)' == '$(SupprocomFFmpegRuntimeIdentifier)'" />
    </ItemGroup>
  </Target>

  <Target Name="SupprocomFFmpegValidateSelection"
          BeforeTargets="SupprocomFFmpegCopyPayload"
          Condition="'$(SupprocomFFmpegCopyToOutput)' == 'true'">
    <Error Condition="'$(SupprocomFFmpegRuntimeIdentifier)' == ''"
           Text="Supprocom FFmpeg could not determine a Runtime Identifier. Set RuntimeIdentifier or SupprocomFFmpegRuntimeIdentifier." />
    <Error Condition="'@(SupprocomFFmpegPayload)' == ''"
           Text="No Supprocom FFmpeg payload is available for Runtime Identifier '$(SupprocomFFmpegRuntimeIdentifier)'." />
  </Target>

  <Target Name="SupprocomFFmpegCopyPayload"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(SupprocomFFmpegCopyToOutput)' == 'true'"
          Inputs="@(SupprocomFFmpegPayload)"
          Outputs="@(SupprocomFFmpegPayload->'$(TargetDir)$(SupprocomFFmpegOutputDirectory)/%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(SupprocomFFmpegPayload)"
          DestinationFiles="@(SupprocomFFmpegPayload->'$(TargetDir)$(SupprocomFFmpegOutputDirectory)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="SupprocomFFmpegCopyPublishPayload"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(SupprocomFFmpegCopyToOutput)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(SupprocomFFmpegPayload)">
        <RelativePath>$(SupprocomFFmpegOutputDirectory)/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
